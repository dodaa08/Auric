{
  "name": "CEX",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.3"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/common/types",
    "packages/common/redis"
  ],
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
